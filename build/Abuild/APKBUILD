# Alpine-Maintainer: Bart Ribbers <bribbers@disroot.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=qt6-declarative
pkgver=6.10.0
pkgrel=0
pkgdesc="Classes for QML and JavaScript languages"
url="https://qt.io/"
arch="all"
license="LGPL-2.1-only AND LGPL-3.0-only AND GPL-3.0-only AND Qt-GPL-exception-1.0"
depends="libc++
        qnx-egl
        qnx-gles
        qnx-io-sock
        qt6-base
        qt6-svg
        "
depends_dev="
    qt6-shadertools-dev
    vulkan-headers
    "
makedepends="
    $depends_dev
    cmake
    perl
    qt6-base-dev
    qt6-base-private-dev
    qt6-languageserver-dev
    qt6-svg-dev
    ninja
    "
subpackages="
    $pkgname-dbg
    $pkgname-private-dev:private_dev
    $pkgname-dev
    "
options="!check" # No tests
builddir="$srcdir/qtdeclarative-everywhere-src-${pkgver/_/-}"

source="https://download.qt.io/official_releases/qt/${pkgver%.*}/${pkgver/_/-}/submodules/qtdeclarative-everywhere-src-${pkgver/_/-}.tar.xz"

_qt6_prefix=usr/lib/qt6

build() {
    # It's qcc here, but compiled with clang on the selfhosted system
    if [[ $CARCH == "x86_64" ]]; then
        _triplet="qnx-x86-64-qcc"
    elif [[ $CARCH == "aarch64" ]]; then
        _triplet="qnx-aarch64le-qcc"
    else
        die "$CARCH not supported"
    fi

    # Clang does not support fortify source on QNX
    _extra_flags="-U_FORTIFY_SOURCE"
    _warn="-Wno-character-conversion"

    export CC=clang
    export CXX=clang++
    export CFLAGS="$_extra_flags $_warn"
    export CXXFLAGS="$_extra_flags $_warn"
    export LDFLAGS="-lsocket"
    export LD_LIBRARY_PATH="$builddir/build/lib:$LD_LIBRARY_PATH"
    
    cmake -B build -G Ninja \
        -DCMAKE_SKIP_RPATH=ON \
        -DQT_QMAKE_TARGET_MKSPEC=$_triplet \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
        -DFEATURE_pkg_config=ON

    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    cd "$pkgdir"
    mkdir -p usr/bin
    while read -r _line; do
        ln -s $_line
    done < "$builddir"/build/user_facing_tool_links.txt
}

dev() {
    default_dev

    # move created symlinks- all dev binaries
    amove usr/bin

    find "$pkgdir"/"$_qt6_prefix"/bin/ -type f ! -name "qmlscene" | while read -r f; do
        file=$(basename $f)
        amove "$_qt6_prefix"/bin/$file
    done

    amove usr/lib/qt6/sbom
}

private_dev() {
    depends="qt6-base-private-dev"

    local file; find "$pkgdir"/usr/include -type d -name private | while read -r file; do
        amove "${file#"$pkgdir"}"
    done

    amove usr/lib/cmake/*Private
    amove usr/lib/qt6/modules/*Private.json
}

sha512sums="
